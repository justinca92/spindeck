{
  "compilerOptions": {
    "outDir": "dist", "module": "ESNext", "target": "ES2020", "jsx": "react",
    "jsxFactory": "window.SP_REACT.createElement", "jsxFragmentFactory": "window.SP_REACT.Fragment",
    "declaration": false, "moduleResolution": "node", "strict": true,
    "noUnusedLocals": true, "esModuleInterop": true, "skipLibCheck": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src"], "exclude": ["node_modules"]
}
